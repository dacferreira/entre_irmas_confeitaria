{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Exceptions", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithExceptionDetails" ]
  },
  "AllowedHosts": "*",

  "USE_SWAGGER": false,
  "CORS_ORIGENS": "",

  "MYSQL_SERVIDOR": "localhost",
  "MYSQL_PORTA": 3306,
  "MYSQL_BANCO": "entreirmas",
  "MYSQL_USUARIO": "entreirmas_app",
  "MYSQL_SENHA": "",
  "MYSQL_VERSAO": "8.0.36",
  "MYSQL_TIMEOUT_SEGUNDOS": 15,

  "HEALTHCHECK_TIMEOUT_SEGUNDOS": 5,

  "JWT_CHAVE": "",
  "JWT_EMISSOR": "entreirmas-api",
  "JWT_AUDIENCIA": "entreirmas-ui",

  "WHATSAPP_NUMERO": "5521990225050",

  "PEDIDO_ANTECEDENCIA_MINIMA_DIAS": 1,
  "PEDIDO_LIMITE_POR_MINUTO": 10
}
